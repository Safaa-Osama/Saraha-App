# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
DB_URI=mongodb://127.0.0.1:27017/sarahaApp
DB_URI_ONLINE=mongodb+srv://<username>:<password>@cluster.mongodb.net/sarahaApp

# JWT Secrets & Configuration
PRIVATE_KEY=your_access_token_secret_key
REFRESH_SECRET_KEY=your_refresh_token_secret_key
PREFIX=Bearer

# Bcrypt & Encryption
SALT_ROUND=10

# Redis Cache & Session Store
REDIS_URI=redis://127.0.0.1:6379

# Cloudinary Storage
CLOUD_NAME=your_cloudinary_name
CLOUD_KEY=your_cloudinary_api_key
CLOUD_SECRET=your_cloudinary_api_secret

# Google OAuth
CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Email Service (Nodemailer Gmail)
EMAIL=your_email@gmail.com
PASS=your_gmail_app_password
TOEMAIL=admin@example.com

# CORS Configuration (comma-separated allowed origins)
ORIGINS=http://localhost:3000,http://localhost:5000
